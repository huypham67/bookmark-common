# IDE & OS junk
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Git & CI (not needed inside the build)
.git
.gitignore
.github/

# Go build & test artifacts (regenerated inside the image)
bin/
*.exe
*.test
*.out
*.tmp
*.log
vendor/
coverage/
coverage_report/
coverage.html
coverage.tmp

# Local env & secrets (gen-keys output, never baked into a build)
.env
.env.*
*.pem
keys/

# Docs & notes not needed in the builder
# NOTE: this is a library — no cmd binary, no swagger docs, no migrations
README.md
LICENSE
CLAUDE.md
